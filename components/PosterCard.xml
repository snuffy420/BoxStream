<?xml version="1.0" encoding="utf-8" ?>
<!-- A poster on a raised bezel with its title below; glows when focused. -->
<component name="PosterCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="width" type="float" onChange="layout" />
        <field id="height" type="float" onChange="layout" />
        <field id="focusPercent" type="float" onChange="onFocus" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
        <field id="rowFocusPercent" type="float" onChange="onFocus" />
        <field id="rowListHasFocus" type="boolean" onChange="onRowFocus" />
        <field id="gridHasFocus" type="boolean" onChange="onFocus" />
        <field id="listHasFocus" type="boolean" onChange="onFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/PosterCard.brs" />
    <script type="text/brightscript" uri="pkg:/components/Common.brs" />
    <children>
        <Group id="body">
            <Poster id="glow" uri="pkg:/images/focus.9.png" opacity="0" />
            <Poster id="bezel" uri="pkg:/images/card.9.png" />
            <Poster id="art" loadDisplayMode="scaleToZoom" loadWidth="300" loadHeight="450" />
            <Poster id="track" uri="pkg:/images/track.9.png" visible="false" />
            <Poster id="bar" uri="pkg:/images/neon-bar.9.png" visible="false" />
            <Group id="tagRow" />
            <Group id="tagTop" />
            <Poster id="badgeBack" uri="pkg:/images/pill.9.png" visible="false" />
            <Label id="badge" visible="false" color="0xFFC857FF" horizAlign="center" vertAlign="center" />
            <Label id="title" color="0xDCE4F2FF" horizAlign="left" maxLines="1" />
            <Label id="subtitle" color="0x7F8CA6FF" horizAlign="left" maxLines="1" />
        </Group>
    </children>
</component>
