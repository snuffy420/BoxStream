<?xml version="1.0" encoding="utf-8" ?>
<!-- A cast member: round-cornered photo (or initials) with name and role. -->
<component name="CastCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="width" type="float" onChange="layout" />
        <field id="height" type="float" onChange="layout" />
        <field id="focusPercent" type="float" onChange="onFocus" />
        <field id="gridHasFocus" type="boolean" onChange="onFocus" />
        <field id="rowListHasFocus" type="boolean" onChange="onRowFocus" />
        <field id="rowFocusPercent" type="float" onChange="onFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/CastCard.brs" />
    <script type="text/brightscript" uri="pkg:/components/Common.brs" />
    <children>
        <Group id="body">
            <Poster id="glow" uri="pkg:/images/focus.9.png" opacity="0" />
            <Poster id="bezel" uri="pkg:/images/card.9.png" />
            <Label id="initials" color="0x39FF88FF" horizAlign="center" vertAlign="center" />
            <Poster id="photo" loadDisplayMode="scaleToZoom" />
            <Label id="name" color="0xDCE4F2FF" horizAlign="center" maxLines="1" />
            <Label id="role" color="0x8391AAFF" horizAlign="center" maxLines="1" />
        </Group>
    </children>
</component>
